// Simple static site data and storage

const verses = [
  // seeded verses (id, reference, text, tags/themes)
  { id:1, ref:"Jeremiah 29:11", text:"For I know the plans I have for you, declares the LORD, plans to prosper you and not to harm you, plans to give you a future and a hope.", tags:["hope","future","plans"]},
  { id:2, ref:"Romans 8:28", text:"And we know that in all things God works for the good of those who love him, who have been called according to his purpose.", tags:["purpose","sovereignty"]},
  { id:3, ref:"Philippians 4:13", text:"I can do all things through him who strengthens me.", tags:["strength","encouragement"]},
  { id:4, ref:"Isaiah 40:31", text:"But they who wait for the LORD shall renew their strength; they shall mount up with wings like eagles...", tags:["strength","hope"]},
  { id:5, ref:"Psalm 32:8", text:"I will instruct you and teach you in the way you should go; I will counsel you with my eye upon you.", tags:["guidance","presence"]},
  { id:6, ref:"Philippians 4:19", text:"And my God will supply every need of yours according to his riches in glory in Christ Jesus.", tags:["provision"]},
  { id:7, ref:"Hebrews 13:5", text:"I will never leave you nor forsake you.", tags:["presence","comfort"]},
  { id:8, ref:"Romans 15:13", text:"May the God of hope fill you with all joy and peace in believing, so that by the power of the Holy Spirit you may abound in hope.", tags:["hope","joy"]},
];

const themes = Array.from(new Set(verses.flatMap(v => v.tags))).sort();

document.addEventListener('DOMContentLoaded', () => {
  // navigation
  document.querySelectorAll('.nav-btn[data-nav]').forEach(btn => {
    btn.addEventListener('click', () => showPage(btn.getAttribute('data-nav')));
  });

  // Verse of the Day
  const votdEl = document.getElementById('votd');
  const nextBtn = document.getElementById('next-votd');
  function showVOTD(seed){
    const idx = Math.floor(Math.random()*verses.length);
    const v = verses[idx];
    votdEl.innerHTML = `<strong>${v.ref}</strong> — ${v.text}`;
  }
  nextBtn.addEventListener('click', ()=> showVOTD());
  showVOTD();

  // search
  const input = document.getElementById('searchInput');
  const results = document.getElementById('searchResults');
  input.addEventListener('input', ()=> {
    const q = input.value.trim().toLowerCase();
    results.innerHTML = '';
    if(!q) return;
    const found = verses.filter(v => v.text.toLowerCase().includes(q) || v.ref.toLowerCase().includes(q));
    if(found.length === 0){
      results.innerHTML = '<li>No matches found.</li>';
      return;
    }
    for(const v of found){
      const li = document.createElement('li');
      li.innerHTML = `<strong>${v.ref}</strong> — ${escapeHtml(v.text)}`;
      results.appendChild(li);
    }
  });

  // promises page tags & list
  const tagContainer = document.getElementById('promiseTags');
  const promiseList = document.getElementById('promiseList');
  function renderTags(){
    tagContainer.innerHTML = '';
    themes.forEach(t => {
      const btn = document.createElement('button');
      btn.className = 'tag';
      btn.textContent = t;
      btn.addEventListener('click', ()=> renderPromises(t));
      tagContainer.appendChild(btn);
    });
    const allBtn = document.createElement('button'); allBtn.className='tag'; allBtn.textContent='All';
    allBtn.addEventListener('click', ()=> renderPromises());
    tagContainer.prepend(allBtn);
  }
  function renderPromises(filter){
    promiseList.innerHTML = '';
    const list = filter ? verses.filter(v => v.tags.includes(filter)) : verses;
    if(list.length === 0) promiseList.innerHTML = '<li>No verses found.</li>';
    list.forEach(v=>{
      const li = document.createElement('li');
      li.innerHTML = `<strong>${v.ref}</strong> — ${escapeHtml(v.text)}<div class="small muted">Tags: ${v.tags.join(', ')}</div>`;
      promiseList.appendChild(li);
    });
  }
  renderTags(); renderPromises();

  // scripture list page
  const scriptureList = document.getElementById('scriptureList');
  function renderScripture(){
    scriptureList.innerHTML = '';
    verses.forEach(v=>{
      const li = document.createElement('li');
      li.innerHTML = `<strong>${v.ref}</strong> — ${escapeHtml(v.text)}`;
      scriptureList.appendChild(li);
    });
  }
  renderScripture();

  // gratitude journal (localStorage)
  const journalForm = document.getElementById('journalForm');
  const entryText = document.getElementById('entryText');
  const entriesList = document.getElementById('entriesList');
  const clearJournal = document.getElementById('clearJournal');
  const JOURNAL_KEY = 'bp_journal_entries_v1';
  function loadEntries(){
    const raw = localStorage.getItem(JOURNAL_KEY) || '[]';
    try {
      return JSON.parse(raw);
    } catch { return []; }
  }
  function saveEntries(arr){
    localStorage.setItem(JOURNAL_KEY, JSON.stringify(arr));
    renderEntries();
  }
  function renderEntries(){
    const arr = loadEntries();
    entriesList.innerHTML = '';
    if(arr.length===0){ entriesList.innerHTML = '<li>No entries yet.</li>'; return; }
    arr.slice().reverse().forEach(e=>{
      const li = document.createElement('li');
      const when = new Date(e.ts);
      li.innerHTML = `<div><small>${when.toLocaleString()}</small></div><div>${escapeHtml(e.text)}</div>`;
      entriesList.appendChild(li);
    });
  }
  journalForm.addEventListener('submit', (ev)=>{
    ev.preventDefault();
    const txt = entryText.value.trim();
    if(!txt) return;
    const arr = loadEntries();
    arr.push({ ts: Date.now(), text: txt });
    saveEntries(arr);
    entryText.value = '';
  });
  clearJournal.addEventListener('click', ()=>{
    if(confirm('Clear all journal entries on this device? This cannot be undone.')){
      localStorage.removeItem(JOURNAL_KEY);
      renderEntries();
    }
  });
  renderEntries();

  // small utilities
  document.getElementById('year').textContent = new Date().getFullYear();

  // page navigation helper
  function showPage(id){
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    const target = document.getElementById(id);
    if(target) {
      target.classList.add('active');
      target.focus();
      window.scrollTo({top:0,behavior:'smooth'});
    }
  }

});

// escape helper
function escapeHtml(s){
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
